# Copy this to .env.local for local dev (never commit .env.local)
# Add these same values in Vercel Dashboard → Settings → Environment Variables

# From @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your Telegram user ID (get from api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot)
CHAT_ID=987654321

# A random secret string — protects /api/cron and /api/test from unauthorized calls
# Generate one: openssl rand -hex 32
CRON_SECRET=replace_with_random_secret_string
